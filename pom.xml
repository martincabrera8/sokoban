<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ar.edu.uade.pds</groupId>
    <artifactId>sokoban</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>Sokoban</name>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <clase.principal>sokoban.Main</clase.principal>
    </properties>

    <dependencies>
        <!-- Solo para las pruebas automáticas (mvn test): no va dentro del juego -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>sokoban</finalName>
        <resources>
            <!-- Las imágenes del grupo (carpeta assets/ de la raíz) se empaquetan dentro del .jar -->
            <resource>
                <directory>assets</directory>
                <targetPath>assets</targetPath>
            </resource>
            <resource>
                <directory>niveles</directory>
                <targetPath>niveles</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${clase.principal}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
