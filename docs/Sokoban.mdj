						{
							"_type": "UMLNoteView",
							"_id": "EjJ7fXa5lz1WfZOBpL4=",
							"_parent": {
								"$ref": "Wg0LSGyTsu2RMkXTs0A="
							},
							"visible": true,
							"enabled": true,
							"lineColor": "#B8892A",
							"fillColor": "#FFFDE7",
							"fontColor": "#000000",
							"font": "Arial;12;0",
							"parentStyle": false,
							"showShadow": false,
							"containerChangeable": false,
							"containerExtending": true,
							"left": 880,
							"top": 2080,
							"width": 900,
							"height": 118,
							"autoResize": false,
							"text": "Cómo leer el diagrama\nSubrayado = static. + público, - privado, # protegido, ~ de paquete. Cursiva = abstracto.\nSe dibujan todos los getters y setters públicos. Se omiten las constantes de estilo (colores, fuentes, tamaños) y los métodos que solo redefinen uno de una interfaz (se leen en la interfaz; los diagramas de cada patrón los muestran cuando importan). JuegoDecorado y JuegoConSonido sí muestran lo que redefinen.\nPara no cruzar todo, estas relaciones están en el modelo pero no se dibujan acá (se ven en los diagramas de cada patrón): MenuPrincipal y PanelAyuda usan Imagenes; PantallaJuego crea los tres comandos (Command); EstadoNivel crea las estrategias y ComportamientoCaja le avisa al mediador (Strategy); Main usa Juego (Decorator); SonidosDeInterfaz alterna el estado (State); JuegoSokoban crea EstadoJuego; SonidoActivado y SonidoSilenciado le cambian el estado a Sonidos; MediadorMovimiento devuelve Evento; RecuerdoNivel guarda la posición del jugador y las cajas; Direccion la usan Juego.mover y Posicion.siguiente.",
							"wordWrap": true,
							"horzAlign": 0,
							"vertAlign": 3
						}
					]
				},
