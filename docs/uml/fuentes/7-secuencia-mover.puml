@startuml 7-secuencia-mover
' Diagrama de secuencia: qué pasa cuando el jugador aprieta la flecha DERECHA.
' Se genera con:  java -jar plantuml.jar -tsvg -o .. docs/uml/fuentes/7-secuencia-mover.puml
skinparam shadowing false
skinparam defaultFontName Inter
skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
skinparam roundCorner 8
skinparam ArrowColor #4A403A
skinparam ArrowThickness 1.3
skinparam sequenceLifeLineBorderColor #8A7F76
skinparam sequenceParticipantBorderColor #6C8EBF
skinparam sequenceParticipantBackgroundColor #DAE8FC
skinparam sequenceActorBorderColor #6E1A2C
skinparam sequenceGroupBorderColor #C9A24A
skinparam sequenceGroupHeaderFontColor #6E1A2C
skinparam noteBackgroundColor #FFFDF5
skinparam noteBorderColor #C9A24A
skinparam titleFontColor #6E1A2C
skinparam titleFontSize 20

title Qué pasa cuando apretás la flecha → (diagrama de secuencia)

actor Jugador
participant "PantallaJuego" as PJ
participant "PanelTablero" as PT
participant "Juego\n(hoy JuegoDePrueba)" as J
participant "PanelHUD" as HUD

Jugador -> PJ : tecla DERECHA
note right of PJ : TECLAS traduce la tecla\nen Direccion.DERECHA
PJ -> PT : mirarHacia(DERECHA)
note right of PT : gira el sprite\n(player_right)
PJ -> J : mover(DERECHA)
activate J
J -> J : valida y mueve\n(paredes, caja, empuje)
group Observer: notificar()
  J -> HUD : actualizar(estado)
  HUD -> HUD : redibuja nivel,\nmovimientos y empujes
  J -> PT : actualizar(estado)
  PT -> PT : repaint()
end
deactivate J
PJ -> J : getEstado()
J --> PJ : EstadoJuego
alt estado.completado()
  PJ -> PJ : mostrarResultado(estado)\n(cartel "¡NIVEL COMPLETADO!")
end
@enduml
