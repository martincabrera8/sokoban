@startuml f06-strategy
!include estilo.iuml
class EstadoNivel <<Cliente: elige la estrategia>> DOMINIO {
  +EstadoNivel(lineas: List<String>)
}
class Caja <<Contexto>> DOMINIO {
  -estrategia: ComportamientoCaja
  -resistencia: int
  -mediador: MediadorMovimiento
  +despuesDeEmpujar()
  +getSimbolo(): char
}
interface ComportamientoCaja <<Estrategia>> DOMINIO {
  +despuesDeEmpujar(caja: Caja, mediador: MediadorMovimiento)
  +simbolo(caja: Caja): char
}
class CajaNormalStrategy <<Estrategia concreta>> DOMINIO
class CajaFragilStrategy <<Estrategia concreta>> DOMINIO
class CajaLlaveStrategy <<Estrategia concreta>> DOMINIO
interface MediadorMovimiento <<recibe los avisos>> DOMINIO {
  +cajaRota(caja: Caja)
  +llaveEmpujada(caja: Caja)
}
EstadoNivel *--> "0..*" Caja : cajas
Caja --> "1" ComportamientoCaja : estrategia
CajaNormalStrategy ..|> ComportamientoCaja
CajaFragilStrategy ..|> ComportamientoCaja
CajaLlaveStrategy ..|> ComportamientoCaja
CajaFragilStrategy ..> MediadorMovimiento : cajaRota
CajaLlaveStrategy ..> MediadorMovimiento : llaveEmpujada
note bottom of CajaNormalStrategy : sin efecto; símbolo $
note bottom of CajaFragilStrategy : resta 1 de resistencia;\nen 0 avisa cajaRota(caja);\nsímbolo F, o f si le queda 1
note bottom of CajaLlaveStrategy : avisa llaveEmpujada(caja);\nsímbolo L
@enduml
