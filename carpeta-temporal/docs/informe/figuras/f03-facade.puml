@startuml f03-facade
!include estilo.iuml
class PantallaJuego <<Cliente>> LUCA
class VentanaPrincipal <<Cliente>> LUCA
class "ComandoMover\nComandoDeshacer\nComandoViajarEnElTiempo" as CMD <<Clientes>> INTEG
interface Juego <<Fachada>> LUCA {
  +getCantidadNiveles(): int
  +iniciarNivel(numero: int)
  +mover(direccion: Direccion)
  +deshacer()
  +reiniciar()
  +viajarEnElTiempo()
  +getEstado(): EstadoJuego
  +agregarObservador(o: ObservadorJuego)
  +quitarObservador(o: ObservadorJuego)
}
class JuegoSokoban <<Fachada concreta>> DOMINIO
class JuegoDecorado <<Decorator: también es un Juego>> INTEG
class "CargadorNivel, EstadoNivel, MotorMovimiento,\nJugador, Caja y estrategias, Posicion,\nRecuerdoNivel, MaquinaDelTiempo" as SUB <<Subsistema del dominio>> DOMINIO
PantallaJuego --> Juego
VentanaPrincipal ..> Juego
CMD --> Juego
JuegoSokoban ..|> Juego
JuegoDecorado ..|> Juego
JuegoSokoban --> SUB : coordina
@enduml
