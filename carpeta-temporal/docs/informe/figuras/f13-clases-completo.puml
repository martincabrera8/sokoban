@startuml f13-clases-completo
!include estilo.iuml
skinparam nodesep 25
skinparam ranksep 40
skinparam defaultFontSize 12
hide members

class Main LUCA

package "sokoban.vista" {
  class VentanaPrincipal LUCA
  class MenuPrincipal LUCA
  class PantallaJuego LUCA
  class PanelHUD LUCA
  class PanelTablero LUCA
  class Cartel LUCA
  class PanelAyuda INTEG
  class Imagenes <<Singleton>> LUCA
  enum Epoca INTEG
}
package "sokoban.comandos" {
  interface Comando INTEG {
    +ejecutar()
  }
  class ComandoMover INTEG
  class ComandoDeshacer INTEG
  class ComandoViajarEnElTiempo INTEG
  class GrabadoraDePartida INTEG
  class Repeticion INTEG
}
package "sokoban.modelo (contrato y decorador base)" {
  abstract class JuegoDecorado <<Decorator>> INTEG
  interface Juego <<Facade>> LUCA {
    +getCantidadNiveles(): int
    +iniciarNivel(numero: int)
    +mover(direccion: Direccion)
    +deshacer()
    +reiniciar()
    +viajarEnElTiempo()
    +getEstado(): EstadoJuego
    +agregarObservador(o: ObservadorJuego)
    +quitarObservador(o: ObservadorJuego)
  }
  interface ObservadorJuego LUCA {
    +actualizar(estado: EstadoJuego)
  }
  class EstadoJuego <<record>> LUCA {
    nivel, movimientos, empujes, undosUsados
    plutonio, viajes, puntosEnElTiempo, puntaje
    completado, sinSolucion, tablero
  }
  enum Direccion LUCA {
    ARRIBA
    ABAJO
    IZQUIERDA
    DERECHA
  }
}
package "sokoban.sonido" {
  class JuegoConSonido <<Decorator>> SONIDO
  class Sonidos <<Singleton>> SONIDO
  enum Sonido SONIDO
  interface EstadoSonido SONIDO {
    +reproducir(clip)
    +alternar(contexto)
  }
  class SonidoActivado SONIDO
  class SonidoSilenciado SONIDO
  class SonidosDeInterfaz SONIDO
}
package "sokoban.modelo (dominio)" {
  class JuegoSokoban DOMINIO
  class CargadorNivel DOMINIO
  class EstadoNivel DOMINIO
  class Posicion <<record>> DOMINIO
  class RecuerdoNivel <<Memento>> INTEG
  class Jugador DOMINIO
  class Caja DOMINIO
  interface ComportamientoCaja DOMINIO {
    +despuesDeEmpujar(caja, mediador)
    +simbolo(caja): char
  }
  class CajaNormalStrategy DOMINIO
  class CajaFragilStrategy DOMINIO
  class CajaLlaveStrategy DOMINIO
  interface MediadorMovimiento DOMINIO {
    +intentarMover(direccion): boolean
    +fueEmpuje(): boolean
    +cajaRota(caja)
    +llaveEmpujada(caja)
  }
  class MotorMovimiento DOMINIO
}
package "sokoban.modelo.tiempo" {
  class MaquinaDelTiempo INTEG
}

Main ..> VentanaPrincipal : crea
Main ..> JuegoConSonido : crea
Main ..> JuegoSokoban : crea
Main ..> SonidosDeInterfaz : instalar()

VentanaPrincipal *--> MenuPrincipal
VentanaPrincipal *--> PantallaJuego
VentanaPrincipal ..> Juego
MenuPrincipal ..> Cartel
PantallaJuego --> Juego
PantallaJuego *--> PanelHUD
PantallaJuego *--> PanelTablero
PantallaJuego ..> Cartel
PantallaJuego *--> GrabadoraDePartida
PantallaJuego --> Repeticion
PantallaJuego ..> ComandoMover : crea
PantallaJuego ..> ComandoDeshacer : crea
PantallaJuego ..> ComandoViajarEnElTiempo : crea
PanelHUD ..|> ObservadorJuego
PanelTablero ..|> ObservadorJuego
PanelTablero --> Epoca
MenuPrincipal ..> Imagenes
PanelHUD ..> Imagenes
PanelTablero ..> Imagenes

ComandoMover ..|> Comando
ComandoDeshacer ..|> Comando
ComandoViajarEnElTiempo ..|> Comando
ComandoMover --> Juego
ComandoDeshacer --> Juego
ComandoViajarEnElTiempo --> Juego
GrabadoraDePartida o--> "0..*" Comando
Repeticion o--> "0..*" Comando

Juego ..> EstadoJuego
Juego ..> ObservadorJuego
ObservadorJuego ..> EstadoJuego

JuegoConSonido --|> JuegoDecorado
JuegoDecorado ..|> Juego
JuegoDecorado o--> "1" Juego : juego
JuegoConSonido ..> Sonidos
SonidosDeInterfaz ..> Sonidos
Sonidos --> EstadoSonido : estado
Sonidos ..> Sonido
SonidoActivado ..|> EstadoSonido
SonidoSilenciado ..|> EstadoSonido

JuegoSokoban ..|> Juego
JuegoSokoban o--> "0..*" ObservadorJuego : observadores
JuegoSokoban o--> CargadorNivel : cargador
Main ..> CargadorNivel : crea
JuegoSokoban --> EstadoNivel : estado
JuegoSokoban --> MediadorMovimiento : motor
JuegoSokoban ..> MotorMovimiento : crea
JuegoSokoban o--> "0..15" RecuerdoNivel : historial
JuegoSokoban *--> MaquinaDelTiempo
MaquinaDelTiempo o--> "0..10" RecuerdoNivel : puntos
RecuerdoNivel --> EstadoNivel
CargadorNivel ..> EstadoNivel : crea
EstadoNivel *--> Jugador
EstadoNivel *--> "0..*" Caja
Jugador --> MediadorMovimiento : mediador
Jugador --> Posicion
Caja --> Posicion
Caja --> ComportamientoCaja : estrategia
CajaNormalStrategy ..|> ComportamientoCaja
CajaFragilStrategy ..|> ComportamientoCaja
CajaLlaveStrategy ..|> ComportamientoCaja
MotorMovimiento ..|> MediadorMovimiento
MotorMovimiento --> EstadoNivel
MotorMovimiento ..> Caja
Caja --> MediadorMovimiento : mediador
ComportamientoCaja ..> MediadorMovimiento
EstadoNivel ..> MediadorMovimiento : conectarColegas
MenuPrincipal ..> PanelAyuda
PanelAyuda ..> Imagenes
show Juego methods
show ObservadorJuego methods
show EstadoJuego fields
show Direccion fields
show Comando methods
show ComportamientoCaja methods
show MediadorMovimiento methods
show EstadoSonido methods
@enduml
