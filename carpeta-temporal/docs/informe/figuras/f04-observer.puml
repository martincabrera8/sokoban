@startuml f04-observer
!include estilo.iuml
interface Juego <<Sujeto>> LUCA {
  +agregarObservador(o: ObservadorJuego)
  +quitarObservador(o: ObservadorJuego)
  +getEstado(): EstadoJuego
}
class JuegoSokoban <<Sujeto concreto>> DOMINIO {
  -observadores: List<ObservadorJuego>
  -notificar()
}
class JuegoDecorado <<delega el registro>> INTEG
interface ObservadorJuego <<Observador>> LUCA {
  +actualizar(estado: EstadoJuego)
}
class PanelHUD <<Observador concreto>> LUCA
class PanelTablero <<Observador concreto>> LUCA
class EstadoJuego <<record: estado que viaja>> LUCA {
  nivel, movimientos, empujes, undosUsados: int
  plutonio, viajes, puntosEnElTiempo, puntaje: int
  completado, sinSolucion: boolean
  tablero: List<String>
}
class PantallaJuego <<registra los observadores>> LUCA
JuegoSokoban ..|> Juego
JuegoDecorado ..|> Juego
JuegoSokoban o--> "0..*" ObservadorJuego : observadores
PanelHUD ..|> ObservadorJuego
PanelTablero ..|> ObservadorJuego
ObservadorJuego ..> EstadoJuego : recibe
PantallaJuego ..> Juego : agregarObservador(hud)\nagregarObservador(tablero)
@enduml
