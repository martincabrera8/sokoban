@startuml f01-paquetes
!include estilo.iuml
skinparam nodesep 30
skinparam ranksep 45
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #B8AFA6
skinparam rectangle {
  RoundCorner 8
  FontSize 12
  StereotypeFontSize 11
  StereotypeFontColor #6E1A2C
}
rectangle "**sokoban**\nMain: raíz de composición\nnew JuegoConSonido(new JuegoSokoban(cargador))" as MAIN LUCA
rectangle "**sokoban.vista**  (Vista)\nVentanaPrincipal, MenuPrincipal, PantallaJuego,\nPanelHUD, PanelTablero, Cartel, PanelAyuda,\nImagenes, Epoca" as VISTA LUCA
rectangle "**sokoban.comandos**  (Command)\nComando, ComandoMover, ComandoDeshacer,\nComandoViajarEnElTiempo, GrabadoraDePartida, Repeticion" as COM INTEG
rectangle "**sokoban.modelo: contrato**\nJuego, ObservadorJuego,\nEstadoJuego, Direccion" as CONTRATO LUCA
rectangle "**sokoban.sonido**  (Decorator, Singleton, State)\nJuegoConSonido, Sonidos, Sonido, EstadoSonido,\nSonidoActivado, SonidoSilenciado, SonidosDeInterfaz" as SND SONIDO
rectangle "**sokoban.modelo: dominio**  (Modelo)\nJuegoSokoban, JuegoDecorado, CargadorNivel, EstadoNivel,\nPosicion, RecuerdoNivel; entidades: Jugador, Caja;\nestrategias: ComportamientoCaja y 3 estrategias;\nmovimiento: MediadorMovimiento, MotorMovimiento" as DOM DOMINIO
rectangle "**sokoban.modelo.tiempo**\nMaquinaDelTiempo" as TIEMPO INTEG

MAIN ..> VISTA : crea la ventana
MAIN ..> SND : crea
MAIN ..> DOM : crea
VISTA ..> COM : crea comandos
VISTA ..> CONTRATO : usa Juego,\nimplementa ObservadorJuego
COM ..> CONTRATO : receptor: Juego
SND ..> CONTRATO : extiende JuegoDecorado\ny envuelve Juego
DOM ..> CONTRATO : implementa Juego
DOM ..> TIEMPO : guarda puntos\nen el tiempo
legend right
  <back:#DAE8FC> Luca: interfaz y contrato </back>
  <back:#FCDDC7> Pedro y Lucía: dominio </back>
  <back:#EEDDF3> Mora: sonido </back>
  <back:#FFF2CC> Martín: integración y funcionalidades adicionales </back>
endlegend
@enduml
