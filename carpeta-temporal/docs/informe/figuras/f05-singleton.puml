@startuml f05-singleton
!include estilo.iuml
left to right direction
class MenuPrincipal <<Cliente>> LUCA
class PanelHUD <<Cliente>> LUCA
class PanelTablero <<Cliente>> LUCA
class Imagenes <<Singleton>> LUCA {
  -{static} instancia: Imagenes
  -cache: Map<String, Image>
  -Imagenes()
  +{static} obtenerInstancia(): Imagenes
  +obtener(ruta: String): Image
  +dibujarFondo(g, ruta, ancho, alto)
}
class JuegoConSonido <<Cliente>> SONIDO
class SonidosDeInterfaz <<Cliente>> SONIDO
class Sonidos <<Singleton, Facade de javax.sound>> SONIDO {
  -{static} instancia: Sonidos
  -clips: Map<Sonido, Clip>
  -estado: EstadoSonido
  -Sonidos()
  +{static} obtenerInstancia(): Sonidos
  +reproducir(sonido: Sonido)
  +alternarSonido()
}
note right of Imagenes : assets/: 107 imágenes PNG,\ncada una se lee una sola vez
note right of Sonidos : assets/sonidos/: 16 efectos WAV,\ncargados una vez al crear la instancia
MenuPrincipal ..> Imagenes
PanelHUD ..> Imagenes
PanelTablero ..> Imagenes
JuegoConSonido ..> Sonidos
SonidosDeInterfaz ..> Sonidos
@enduml
