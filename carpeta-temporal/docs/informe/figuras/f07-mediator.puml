@startuml f07-mediator
!include estilo.iuml
class Jugador <<Colega>> DOMINIO {
  -mediador: MediadorMovimiento
  +conectar(m: MediadorMovimiento)
  +mover(direccion: Direccion): boolean
}
class Caja <<Colega>> DOMINIO {
  -mediador: MediadorMovimiento
  +conectar(m: MediadorMovimiento)
  +despuesDeEmpujar()
}
interface MediadorMovimiento <<Mediador>> DOMINIO {
  +intentarMover(direccion: Direccion): boolean
  +fueEmpuje(): boolean
  +cajaRota(caja: Caja)
  +llaveEmpujada(caja: Caja)
}
class MotorMovimiento <<Mediador concreto>> DOMINIO {
  -estado: EstadoNivel
  -empuje: boolean
  +MotorMovimiento(estado: EstadoNivel)
}
class EstadoNivel <<tablero>> DOMINIO {
  +conectarColegas(m: MediadorMovimiento)
  +cajaEn(p: Posicion): Caja
  +estaLibre(p: Posicion): boolean
  +esHielo(p: Posicion): boolean
  +quitarCaja(caja: Caja)
  +abrirMuros()
}
class JuegoSokoban <<crea el motor>> DOMINIO {
  -motor: MediadorMovimiento
}
Jugador --> "1" MediadorMovimiento : mediador
Caja --> "1" MediadorMovimiento : mediador
MotorMovimiento ..|> MediadorMovimiento
MotorMovimiento --> "1" EstadoNivel : estado
EstadoNivel ..> MediadorMovimiento : conectarColegas
JuegoSokoban --> "1" MediadorMovimiento : motor
JuegoSokoban ..> MotorMovimiento : new MotorMovimiento(estado)
note right of Caja : su estrategia avisa\ncajaRota o llaveEmpujada
@enduml
