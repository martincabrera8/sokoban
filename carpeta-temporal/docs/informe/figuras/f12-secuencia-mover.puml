@startuml f12-secuencia-mover
skinparam shadowing false
skinparam defaultFontName Inter
skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
skinparam roundCorner 8
skinparam ArrowColor #4A403A
skinparam ArrowThickness 1.2
skinparam sequenceLifeLineBorderColor #8A7F76
skinparam sequenceParticipantBorderColor #6C8EBF
skinparam sequenceParticipantBackgroundColor #DAE8FC
skinparam sequenceActorBorderColor #6E1A2C
skinparam sequenceGroupBorderColor #C9A24A
skinparam sequenceGroupHeaderFontColor #6E1A2C
skinparam noteBackgroundColor #FFFDF5
skinparam noteBorderColor #C9A24A

actor Jugador as U
participant "PantallaJuego\n(Cliente)" as PJ
participant "GrabadoraDePartida\n(Invocador)" as GR #FFF2CC
participant "c: ComandoMover" as CM #FFF2CC
participant "JuegoConSonido\n(Decorator)" as JS #EEDDF3
participant "JuegoSokoban\n(Facade)" as JK #FCDDC7
participant "nivel: EstadoNivel\n(Originador)" as EN #FCDDC7
participant "jugador:\nJugador" as JU #FCDDC7
participant "MotorMovimiento\n(Mediator)" as MM #FCDDC7
participant "caja: Caja\n(Strategy)" as CA #FCDDC7
participant "HistorialDeshacer y\nMaquinaDelTiempo" as CU #FFF2CC
participant "PanelHUD y\nPanelTablero" as OBS
participant "Sonidos\n(Singleton)" as SO #EEDDF3

U -> PJ : tecla DERECHA
PJ -> CM ** : new ComandoMover(juego, DERECHA)
PJ -> GR : ejecutar(c)
activate GR
GR -> CM : ejecutar()
CM -> JS : mover(DERECHA)
activate JS
JS -> JK : super.mover(DERECHA)
activate JK
JK -> EN : crearRecuerdo()
EN --> JK : antes: RecuerdoNivel
JK -> EN : moverJugador(DERECHA)
EN -> JU : mover(DERECHA)
JU -> MM : intentarMover(DERECHA)
activate MM
MM -> MM : caja adelante y detrás libre\n(si es hielo, desliza)
MM -> CA : setPosicion(destino)
MM -> CA : despuesDeEmpujar()
CA -> MM : cajaDanada / cajaRota / llaveEmpujada\n(según la estrategia)
MM -> JU : setPosicion(siguiente)
MM -> EN : contarMovimiento(true)\nrecogerPlutonio(siguiente)
MM --> JU : evento (EMPUJE, ...)
deactivate MM
JU --> EN : evento
EN --> JK : evento
JK -> CU : historial.guardar(antes)
opt llegó una caja a un destino
  JK -> CU : maquinaDelTiempo.guardar(movimientos, crearRecuerdo())
end
group Observer: notificarObservadores()
  JK -> OBS : actualizar(estadoJuego)
end
deactivate JK
JS -> JK : getEstado()
JK --> JS : estadoJuego (con su evento)
JS -> SO : reproducir(Sonido.de(evento))
deactivate JS
GR -> GR : comandos.add(c)
deactivate GR
PJ -> JS : getEstado()
JS --> PJ : estadoJuego
alt completado()
  PJ -> PJ : mostrarResultado
else sinSolucion()
  PJ -> PJ : mostrarCajaRota
end
@enduml
