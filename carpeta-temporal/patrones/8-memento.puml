@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
  ArrowColor #333333
}
hide circle
hide empty members

class JuegoSokoban <<Cliente>> {
  + mover(direccion: Direccion): void
  + deshacer(): void
  + viajarEnElTiempo(): void
}
class EstadoNivel <<Originador>> {
  - terreno: char[][]
  - cajas: List<Caja>
  - movimientos: int
  + crearRecuerdo(): RecuerdoNivel
  + restaurar(recuerdo: RecuerdoNivel): void
  + viajarA(punto: RecuerdoNivel): void
}
class RecuerdoNivel <<final>> <<Memento>> {
  - terreno: char[][]
  - posicionJugador: Posicion
  - cajas: List<Caja>
  - movimientos: int
  - empujes: int
  - plutonio: int
  ~ RecuerdoNivel(terreno: char[][], posicionJugador: Posicion,\n    cajas: List<Caja>, movimientos: int, empujes: int, plutonio: int)
  ~ terreno(): char[][]
  ~ posicionJugador(): Posicion
  ~ cajas(): List<Caja>
  ~ movimientos(): int
  ~ empujes(): int
  ~ plutonio(): int
}
class HistorialDeshacer <<Cuidador: deshacer>> {
  - recuerdos: Deque<RecuerdoNivel>
  + guardar(recuerdo: RecuerdoNivel): void
  + deshacer(): RecuerdoNivel
}
class MaquinaDelTiempo <<Cuidador: DeLorean>> {
  - puntos: Deque<Punto>
  + guardar(movimiento: int, recuerdo: RecuerdoNivel): void
  + volverAntesDe(movimientoActual: int): RecuerdoNivel
}
class "MaquinaDelTiempo.Punto" as Punto <<record>> {
  - movimiento: int
  - recuerdo: RecuerdoNivel
}

JuegoSokoban --> "0..1" EstadoNivel : nivel
JuegoSokoban --> "1" HistorialDeshacer : historial
JuegoSokoban --> "1" MaquinaDelTiempo : maquinaDelTiempo
EstadoNivel ..> RecuerdoNivel : crea y lee
HistorialDeshacer o--> "0..15" RecuerdoNivel : recuerdos
MaquinaDelTiempo o--> "0..10" Punto : puntos
MaquinaDelTiempo +-- Punto
Punto --> "1" RecuerdoNivel : recuerdo
@enduml
