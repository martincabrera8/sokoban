@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
  ArrowColor #333333
}
hide circle
hide empty members

class PantallaJuego <<Cliente>> {
  - juego: Juego
}
interface Juego <<interface>> <<Fachada>> {
  + getCantidadNiveles(): int
  + iniciarNivel(numero: int): void
  + mover(direccion: Direccion): void
  + deshacer(): void
  + reiniciar(): void
  + viajarEnElTiempo(): void
  + getEstado(): EstadoJuego
}
class JuegoSokoban <<Fachada concreta>> {
  - nivel: EstadoNivel
  - historial: HistorialDeshacer
  - maquinaDelTiempo: MaquinaDelTiempo
  - puntaje: Puntaje
  - cargador: CargadorNivel
}

together {
  class CargadorNivel <<Subsistema>> {
    + cargar(numero: int): EstadoNivel
  }
  class EstadoNivel <<Subsistema>> {
    + conectarMediador(mediador: MediadorMovimiento): void
    + moverJugador(direccion: Direccion): Evento
    + crearRecuerdo(): RecuerdoNivel
    + restaurar(recuerdo: RecuerdoNivel): void
  }
  class MotorMovimiento <<Subsistema>> {
    + intentarMover(direccion: Direccion): Evento
  }
  class HistorialDeshacer <<Subsistema>> {
    + guardar(recuerdo: RecuerdoNivel): void
    + deshacer(): RecuerdoNivel
  }
  class MaquinaDelTiempo <<Subsistema>> {
    + guardar(movimiento: int, recuerdo: RecuerdoNivel): void
    + volverAntesDe(movimientoActual: int): RecuerdoNivel
  }
  class Puntaje <<Subsistema>> {
    + registrarDeshacer(): void
    + calcular(movimientos: int, empujes: int): int
  }
}

PantallaJuego --> "1" Juego : juego
JuegoSokoban .up.|> Juego
JuegoSokoban --> "1" CargadorNivel : cargador
JuegoSokoban --> "0..1" EstadoNivel : nivel
JuegoSokoban ..> MotorMovimiento : crea
JuegoSokoban --> "1" HistorialDeshacer : historial
JuegoSokoban --> "1" MaquinaDelTiempo : maquinaDelTiempo
JuegoSokoban --> "1" Puntaje : puntaje
MotorMovimiento --> "1" EstadoNivel : nivel
@enduml
